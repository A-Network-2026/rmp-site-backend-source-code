# Core
PORT=3000
JWT_SECRET=replace_with_long_random_secret

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=anetwork
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anetwork
REPLICA_DATABASE_URL=

# DB Pool / Query Tuning
PGPOOL_MAX=10
PGPOOL_MIN=2
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
PGPOOL_QUERY_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=100
HALVING_REFRESH_MS=60000

# Optional per-pool overrides
PG_PRIMARY_MAX=10
PG_PRIMARY_QUERY_TIMEOUT_MS=15000
PG_REPLICA_MAX=20
PG_REPLICA_QUERY_TIMEOUT_MS=15000
REPLICA_QUERY_RETRIES=1
REPLICA_RETRY_DELAY_MS=120

# CORS
CORS_ORIGINS=*

# API Rate Limits (global)
RATE_LIMIT_MAX=1500
RATE_LIMIT_WINDOW=15 minutes

# Stats anti-scraping controls (set true only when you need strict blocking)
STATS_AUTO_BLOCK_ENABLED=false
STATS_SUBNET_COOLDOWN_ENABLED=false
NETWORK_STATS_CACHE_MS=30000
COUNTRY_STATS_CACHE_MS=60000
STATS_USE_PRECOMPUTED=true
STATS_PRECOMPUTE_TARGET_AGE_MS=30000
STATS_PRECOMPUTE_MAX_STALE_MS=900000

# Email / OTP
RESEND_API_KEY=
EMAIL_FROM=A-Network <no-reply@mail.a-network.net>
EMAIL_REPLY_TO=info@a-network.net
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_DEBUG=false
LOGIN_DEVICE_OTP_REQUIRED=false

# Email provider routing:
#   SMTP_PROVIDER=auto   -> Resend first, Gmail fallback (recommended for scale)
#   SMTP_PROVIDER=resend -> Resend only
#   SMTP_PROVIDER=gmail  -> Gmail first, Resend fallback
# Leave blank to use auto mode.

# Gmail SMTP (for fallback or Gmail-first mode)
# Use a Google App Password (NOT your account password):
#   https://myaccount.google.com/apppasswords
# EMAIL_FROM must match SMTP_USER when using Gmail SMTP
SMTP_PROVIDER=
SMTP_USER=no-reply@a-network.net
SMTP_APP_PASSWORD=

# Anti-Abuse Controls
DEVICE_MAX_ACCOUNTS=2
MINING_HEARTBEAT_MAX_GAP_MINUTES=120
MINING_HEARTBEAT_MIN_REQUIRED=2
ANTI_ABUSE_RISK_BLOCK_THRESHOLD=5
IP_CLUSTER_ACCOUNT_THRESHOLD=8
FINGERPRINT_CLUSTER_ACCOUNT_THRESHOLD=4
BOT_PATTERN_LOOKBACK=8
REQUIRE_OFFICIAL_CLIENT_HEADERS=false
BLOCK_INSECURE_RUNTIME=false

# Optional Admin IDs for protected endpoints
ADMIN_USER_IDS=1

# Startup schema/backfill controls (keep false in production unless running planned migrations)
RUN_AUTH_SCHEMA_SYNC_STARTUP=false
RUN_STARTUP_BACKFILLS=false
RUN_STARTUP_BACKFILLS_SYNC=false
RUN_MINING_SCHEMA_SYNC_STARTUP=false
RUN_MINING_SESSION_RECONCILE_STARTUP=false
RUN_MINING_TYPE_ALTER_STARTUP=false
RUN_STATS_SCHEMA_SYNC_STARTUP=false
RUN_ADMIN_SCHEMA_SYNC_STARTUP=false
RUN_COLONY_SCHEMA_SYNC_STARTUP=false
RUN_CHATBOT_SCHEMA_SYNC_STARTUP=false

# Ads Support / Supporter Badge
SUPPORTER_MIN_DAYS=3
SUPPORTER_MIN_IMPRESSIONS=30
SUPPORTER_WORKER_MINUTES=60
ADS_IMPRESSION_TOKEN=
ADS_IMPRESSION_RATE_MAX_PER_MIN=30
ADS_IMPRESSION_SPIKE_WINDOW_MINUTES=10
ADS_IMPRESSION_SPIKE_THRESHOLD=120
